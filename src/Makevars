ifeq ($(shell uname -s),Darwin)
PKG_CPPFLAGS = -I../include -I../gpu -std=c++17 -DGPU_METAL
PKG_CXXFLAGS = -O3
PKG_LIBS = MetalContext_gpu.o GFRAccel_gpu.o -framework Metal -framework Foundation

$(SHLIB): MetalContext_gpu.o GFRAccel_gpu.o

MetalContext_gpu.o: ../gpu/MetalContext.mm
	$(CXX) -x objective-c++ $(ALL_CPPFLAGS) $(CXXFLAGS) $(CXXPICFLAGS) -c -o $@ $<

GFRAccel_gpu.o: ../gpu/GFRAccel.cpp
	$(CXX) $(ALL_CPPFLAGS) $(CXXFLAGS) $(CXXPICFLAGS) -c -o $@ $<
else
PKG_CPPFLAGS = -I../include -std=c++17
PKG_CXXFLAGS = -O3
endif
